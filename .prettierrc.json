{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "editor.formatOnSave": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "BracketSameLine": true,
  "arrowParens": "avoid",
  "proseWrap": "never",
  "htmlWhitespaceSensitivity": "ignore"
}
